{
    "target": "esp32c3",
    "builds": [
        {
            "name": "mz01-c3-lcd",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_MZ01_C3_LCD=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions_mz01_8M.csv\"",
                "CONFIG_PARTITION_TABLE_FILENAME=\"partitions_mz01_8M.csv\"",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_AUDIO_PROCESSOR=n",
                "CONFIG_USE_EYE_STYLE_VB6824=y",
                "CONFIG_USE_GIZWITS_MQTT=n",
                "CONFIG_VB6824_UART_TASK_STACK_SIZE=8192",
                "CONFIG_VB6824_SEND_USE_TASK=y",
                "CONFIG_VB6824_SEND_TASK_STACK_SIZE=4096",
                "CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096"
            ]
        }
    ]
}
